{#
  NOTE: Component arguments are rendered inline as JSON (valid YAML): a mapping
        before kubeadm v1beta4 and a list of name/value pairs from it.
#}
---
apiVersion: kubeadm.k8s.io/{{ kubernetes_kubeadm_api_version }}
kind: InitConfiguration
localAPIEndpoint:
  advertiseAddress: "{{ kubernetes_node_ip }}"
nodeRegistration:
{% if kubernetes_kubeadm_api_version == 'v1beta4' %}
  criSocket: "{{ kubelet_cri_socket }}"
{% endif %}
  kubeletExtraArgs: {{ kubernetes_kubeadm_kubelet_args | vexxhost.kubernetes.kubeadm_args(kubernetes_kubeadm_api_version) | to_json }}
---
apiVersion: kubeadm.k8s.io/{{ kubernetes_kubeadm_api_version }}
kind: JoinConfiguration
nodeRegistration:
{% if kubernetes_kubeadm_api_version == 'v1beta4' %}
  criSocket: "{{ kubelet_cri_socket }}"
{% endif %}
  kubeletExtraArgs: {{ kubernetes_kubeadm_kubelet_args | vexxhost.kubernetes.kubeadm_args(kubernetes_kubeadm_api_version) | to_json }}
{% if (kubernetes_bootstrap_node is not defined) or (kubernetes_bootstrap_node is defined and inventory_hostname != kubernetes_bootstrap_node) %}
discovery:
  bootstrapToken:
    token: "{{ kubernetes_kubeadm_token_create.stdout | trim }}"
    apiServerEndpoint: "{{ kubernetes_hostname }}:6443"
    caCertHashes: ["sha256:{{ kubernetes_kubeadm_certificate_info.public_key_fingerprints.sha256 | replace(':', '') }}"]
{% if inventory_hostname in groups[kubernetes_control_plane_group] %}
controlPlane:
  localAPIEndpoint:
    advertiseAddress: "{{ kubernetes_node_ip }}"
  certificateKey: {{ kubernetes_kubeadm_init_upload_certs.stdout_lines[-1] | trim }}
{% endif %}
{% endif %}
---
apiVersion: kubeadm.k8s.io/{{ kubernetes_kubeadm_api_version }}
kind: ClusterConfiguration
kubernetesVersion: v{{ kubernetes_version }}
controlPlaneEndpoint: "{{ kubernetes_hostname }}:6443"
{% if kubernetes_image_repository not in ("registry.k8s.io", "k8s.gcr.io") %}
imageRepository: "{{ kubernetes_image_repository }}"
dns:
  imageRepository: "{{ kubernetes_image_repository }}/coredns"
{% endif %}
{% if kubernetes_kubeadm_api_version == 'v1beta4' and kubernetes_remove_kube_proxy | bool %}
proxy:
  disabled: true
{% endif %}
etcd:
  local:
    extraArgs: {{ kubernetes_kubeadm_etcd_args | vexxhost.kubernetes.kubeadm_args(kubernetes_kubeadm_api_version) | to_json }}
apiServer:
  extraArgs: {{ kubernetes_kubeadm_api_server_args | vexxhost.kubernetes.kubeadm_args(kubernetes_kubeadm_api_version) | to_json }}
controllerManager:
  extraArgs: {{ kubernetes_kubeadm_controller_manager_args | vexxhost.kubernetes.kubeadm_args(kubernetes_kubeadm_api_version) | to_json }}
scheduler:
  extraArgs: {{ kubernetes_kubeadm_scheduler_args | vexxhost.kubernetes.kubeadm_args(kubernetes_kubeadm_api_version) | to_json }}
---
apiVersion: kubelet.config.k8s.io/v1beta1
kind: KubeletConfiguration
{% if kubernetes_version is ansible.builtin.version('1.28.0', '>=') %}
tlsMinVersion: VersionTLS13
{% endif %}
---
apiVersion: kubeproxy.config.k8s.io/v1alpha1
kind: KubeProxyConfiguration
metricsBindAddress: 0.0.0.0
{% if kubernetes_non_init_namespace %}
conntrack:
  maxPerCore: 0
{% endif %}
